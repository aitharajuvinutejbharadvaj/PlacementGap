# Optional model-based JD extraction. Without a key, offline fixture mode is used.
OPENAI_API_KEY=
PLACEMENTGAP_MODEL_FAST=gpt-4o-mini
PLACEMENTGAP_MODEL_STRONG=gpt-4o
PLACEMENTGAP_MAX_USD=0.50
PLACEMENTGAP_MAX_TOKENS=30000

# Set a stable random secret for signed account sessions (openssl rand -hex 32).
PLACEMENTGAP_SESSION_SECRET=
# Set true when serving the site over HTTPS (leave false for local HTTP).
PLACEMENTGAP_HTTPS=false

# Required for account verification links and successful sign-in notifications.
# Use a Resend send-only API key and an address on a domain verified in Resend.
PLACEMENTGAP_RESEND_API_KEY=
# Example format: PlacementGap <no-reply@your-verified-domain.example>
PLACEMENTGAP_MAIL_FROM=
# The public website URL used in verification and security emails.
PLACEMENTGAP_PUBLIC_URL=http://localhost:5173

# Optional social sign-in. Google uses an OAuth web client ID (public).
# GitHub uses an OAuth App client ID and client secret (keep the secret private).
PLACEMENTGAP_GOOGLE_CLIENT_ID=
PLACEMENTGAP_GITHUB_CLIENT_ID=
PLACEMENTGAP_GITHUB_CLIENT_SECRET=

# Optional: PostgreSQL DSN reserved for Postgres-backed deployments.
DATABASE_URL=postgresql://placementgap:placementgap@localhost:5432/placementgap
