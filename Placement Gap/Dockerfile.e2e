FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml requirements.txt requirements-dev.txt ./
COPY agent ./agent
COPY api ./api
COPY config ./config
COPY evals ./evals
COPY memory ./memory
COPY ontology ./ontology
COPY tests ./tests
COPY e2e ./e2e

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e ".[dev]"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLACEMENTGAP_FIXTURES=1 \
    PLACEMENTGAP_SESSION_SECRET=placementgap-ci-session-secret-not-for-production \
    PLACEMENTGAP_HTTPS=false

CMD ["python", "-m", "pytest", "-q", "e2e", "--junitxml=/app/artifacts/selenium/junit.xml"]
